# Использование образа с исполняющей средой Node.js для этапа сборки
FROM node:20-alpine AS build
# Назначение рабочей директории внутри файловой системы контейнера
WORKDIR /app
# Копирование файлов с описанием зависимостей для формирования слоя кэша
COPY package*.json ./
# Установка всех зависимостей проекта согласно фиксированным версиям
RUN npm ci
# Копирование всех исходных файлов проекта в рабочую директорию
COPY . .
# Запуск процесса транспиляции и компиляции статических файлов
RUN npm run build
# Использование базового образа HTTP-сервера Nginx для этапа раздачи
FROM nginx:alpine
# Перенос скомпилированных файлов из промежуточного образа в паблик-директорию Nginx
COPY --from=build /app/dist /usr/share/nginx/html
# Открытие сетевого порта номер 80 внутри виртуальной сети контейнера
EXPOSE 80
# Запуск процесса веб-сервера Nginx в постоянном режиме
CMD ["nginx", "-g", "daemon off;"]