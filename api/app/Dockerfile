# Использование официального базового образа Python с минимальным размером
FROM python:3.11-slim
# Назначение рабочей директории внутри файловой системы контейнера
WORKDIR /app
# Копирование файла с перечнем зависимостей в рабочую директорию
COPY requirements.txt .
# Установка зависимостей без сохранения локального кэша пакетов
RUN pip install --no-cache-dir -r requirements.txt
# Копирование всех исходных файлов бэкенда в контейнер
COPY . .
# Назначение команды запуска сервера Uvicorn для обработки HTTP-запросов
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]